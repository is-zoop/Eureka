{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "eureka-localhost",
  "description": "Allow the bundled Eureka localhost frontend to synchronize the native window theme.",
  "webviews": ["eureka-content"],
  "remote": {
    "urls": ["http://127.0.0.1:8080/*"]
  },
  "permissions": [
    "allow-set-desktop-theme",
    "allow-set-desktop-navigation-state",
    "allow-desktop-menu-content",
    "allow-desktop-clipboard-files",
    "allow-desktop-select-attachments",
    "allow-desktop-select-directory",
    "allow-open-external-url",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
