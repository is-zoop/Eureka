{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "eureka-titlebar",
  "description": "Local-only controls for the persistent Eureka titlebar.",
  "webviews": ["eureka-titlebar"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-resize-dragging",
    "allow-desktop-window-action",
    "allow-desktop-menu-titlebar"
  ]
}
