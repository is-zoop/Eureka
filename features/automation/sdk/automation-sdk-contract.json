{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "sdkVersion": "1.3.0",
  "capabilities": [
    "files.read",
    "files.write",
    "browser.read",
    "browser.write",
    "ai",
    "clarification",
    "artifacts"
  ],
  "valueTypes": [
    "text",
    "number",
    "boolean",
    "date",
    "percentage",
    "object",
    "list"
  ],
  "limits": {
    "httpResponseBytes": 16777216,
    "legacyDownloadBytes": 12582912,
    "downloadBytes": 1073741824,
    "downloadTimeoutMs": 180000,
    "maxDownloadTimeoutMs": 1800000,
    "fileChunkBytes": 1048576,
    "zipArchiveBytes": 1073741824,
    "zipFileBytes": 536870912,
    "zipExpandedBytes": 1073741824,
    "executionValueBytes": 20971520,
    "packageBytes": 16777216,
    "packageFiles": 256,
    "tableBatchRows": 2000,
    "tableHandles": 8,
    "xlsxInputBytes": 33554432,
    "xlsxExpandedBytes": 134217728,
    "uploadBytes": 536870912,
    "uploadFiles": 16,
    "redirects": 3,
    "checkpointBytes": 262144,
    "browserUploadSelections": 16,
    "browserContextDepth": 3,
    "artifactBytes": 1073741824,
    "artifactFiles": 64
  },
  "methods": {
    "files": [
      "list",
      "readText",
      "readJson",
      "readBytes",
      "writeText",
      "writeJson",
      "writeBytes",
      "mkdir",
      "copy",
      "move",
      "extractZip",
      "readChunk",
      "createWriter"
    ],
    "tables": [
      "openReader",
      "readRows",
      "closeReader",
      "createWriter",
      "appendRows",
      "commitWriter",
      "abortWriter"
    ],
    "browser": [
      "connect",
      "release",
      "observe",
      "locate",
      "read",
      "extract",
      "navigate",
      "operation",
      "request",
      "download",
      "waitFor"
    ],
    "checkpoints": [
      "load",
      "save"
    ],
    "artifacts": [
      "write",
      "fromFile"
    ]
  },
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 1
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "OPTIONS",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "credentials": {
          "enum": [
            "browser",
            "omit"
          ]
        },
        "headers": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^(?:[Aa][Cc][Cc][Ee][Pp][Tt]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Tt][Yy][Pp][Ee]|[Rr][Ee][Ff][Ee][Rr][Ee][Rr]|[Xx]-[Rr][Ee][Qq][Uu][Ee][Ss][Tt][Ee][Dd]-[Ww][Ii][Tt][Hh]|[Uu][Ss][Ee][Rr]-[Aa][Gg][Ee][Nn][Tt])$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 64000
          }
        },
        "response": {
          "enum": [
            "json",
            "text",
            "bytes"
          ]
        },
        "allowDynamicUrl": {
          "type": "boolean"
        },
        "signature": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "taobao-mtop"
            },
            "appKey": {
              "type": "string",
              "pattern": "^[0-9]{1,30}$"
            }
          },
          "required": [
            "kind",
            "appKey"
          ],
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "bearer",
                "api-key"
              ]
            },
            "credentialId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,79}$"
            },
            "header": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]{0,79}$"
            }
          },
          "required": [
            "kind",
            "credentialId"
          ],
          "additionalProperties": false
        },
        "multipart": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              }
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                  },
                  "multiple": {
                    "type": "boolean"
                  },
                  "contentTypes": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 536870912
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "responseHeaders": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "content-type",
              "content-disposition",
              "retry-after",
              "etag",
              "last-modified"
            ]
          }
        },
        "redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        }
      },
      "required": [
        "url",
        "method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "allowDynamicUrl": {
                "const": true
              }
            },
            "required": [
              "allowDynamicUrl"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "GET"
              },
              "response": {
                "const": "bytes"
              },
              "url": {
                "pattern": "^[^?#]+$"
              }
            },
            "required": [
              "response"
            ],
            "not": {
              "required": [
                "signature"
              ]
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "properties": {
        "css": {
          "type": "string",
          "maxLength": 4000
        },
        "role": {
          "type": "string",
          "maxLength": 4000
        },
        "name": {
          "type": "string",
          "maxLength": 4000
        },
        "label": {
          "type": "string",
          "maxLength": 4000
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "testId": {
          "type": "string",
          "maxLength": 4000
        },
        "within": {},
        "nth": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "locator"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "frame",
                  "shadow"
                ]
              },
              "locator": {
                "$ref": "#/$defs/locator"
              }
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "pageField": {
      "type": "object",
      "properties": {
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "source": {
          "enum": [
            "text",
            "value",
            "checked",
            "attribute"
          ]
        },
        "attribute": {
          "type": "string",
          "maxLength": 4000
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "percentage",
            "object",
            "list"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "prefix": {
          "type": "string",
          "maxLength": 100
        },
        "suffix": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "effect": {
          "enum": [
            "query",
            "mutation"
          ]
        },
        "kind": {
          "enum": [
            "click",
            "fill",
            "select",
            "check",
            "enter",
            "request",
            "upload"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "row": {
          "type": "object",
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "key": {
              "$ref": "#/$defs/pageField"
            }
          },
          "required": [
            "locator",
            "key"
          ],
          "additionalProperties": false
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "verify": {
          "type": "object",
          "properties": {
            "field": {
              "$ref": "#/$defs/pageField"
            },
            "mode": {
              "enum": [
                "equals",
                "changed"
              ]
            },
            "expected": {},
            "input": {
              "type": "boolean"
            }
          },
          "required": [
            "field",
            "mode"
          ],
          "additionalProperties": false
        },
        "upload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "multiple": {
              "type": "boolean"
            },
            "contentTypes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
              }
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            }
          }
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "effect",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "request"
              }
            }
          },
          "then": {
            "required": [
              "request"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "locator"
                  ]
                },
                {
                  "required": [
                    "row"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "locator"
            ],
            "not": {
              "required": [
                "request"
              ]
            }
          }
        }
      ]
    },
    "browser": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "maxLength": 120
              },
              "startUrl": {
                "type": "string",
                "maxLength": 4096
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 1000
                },
                "maxItems": 32,
                "minItems": 1
              },
              "account": {
                "$ref": "#/$defs/pageField"
              },
              "operations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/operation"
                },
                "maxItems": 100
              }
            },
            "required": [
              "id",
              "label",
              "startUrl",
              "paths",
              "operations"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        }
      },
      "required": [
        "schemaVersion",
        "sites"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "boolean",
                  "date",
                  "percentage",
                  "object",
                  "list",
                  "file",
                  "directory"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              },
              "default": {},
              "multiline": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "layout": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "maxItems": 256,
              "uniqueItems": true
            },
            "spans": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            }
          },
          "required": [
            "columns"
          ],
          "additionalProperties": false
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "action": {
                "const": "run"
              }
            },
            "required": [
              "id",
              "label",
              "action"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "results": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "type": {
                    "enum": [
                      "text",
                      "number",
                      "boolean",
                      "date",
                      "percentage",
                      "object",
                      "list"
                    ]
                  }
                },
                "required": [
                  "key",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              "maxItems": 256
            },
            "download": {
              "type": "boolean"
            }
          },
          "required": [
            "columns"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "fields",
        "buttons",
        "results"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "script",
                  "browser",
                  "ai",
                  "branch",
                  "loop",
                  "wait-user"
                ]
              },
              "script": {
                "type": "string",
                "maxLength": 240
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": false
          },
          "maxItems": 256,
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "when": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "maxItems": 1024
        }
      },
      "required": [
        "schemaVersion",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "entry": {
          "type": "string",
          "maxLength": 240
        },
        "ui": {
          "type": "string",
          "maxLength": 240
        },
        "workflow": {
          "type": "string",
          "maxLength": 240
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "files.read",
              "files.write",
              "browser.read",
              "browser.write",
              "ai",
              "clarification",
              "artifacts"
            ]
          },
          "maxItems": 7,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "entry",
        "ui",
        "workflow"
      ],
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$"
        },
        "runtime": {
          "const": "javascript-esm"
        },
        "entry": {
          "type": "string",
          "maxLength": 240
        },
        "ui": {
          "const": "ui.json"
        },
        "workflow": {
          "const": "workflow.json"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "files.read",
              "files.write",
              "browser.read",
              "browser.write",
              "ai",
              "clarification",
              "artifacts"
            ]
          },
          "maxItems": 7,
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "browser": {
          "$ref": "#/$defs/browser"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "checkpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            }
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "runtime",
        "entry",
        "ui",
        "workflow",
        "capabilities",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://eureka.local/schemas/automation-sdk/1.2.0"
}
